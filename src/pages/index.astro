---
import "../styles/global.css"

const links = [
  { label: "Website", href: "https://adarshrkumar.dev" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/adarshrkumar/" },
]
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Adarsh R. Kumar — Computer Science undergraduate, developer, and curious maker." />
    <title>Adarsh R. Kumar — ARK</title>
  </head>
  <body>
    <header class="site-header">
      <a class="mark" href="#top" aria-label="Back to top">ARK</a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#work">What I do</a>
        <a class="nav-link" href="https://adarshrkumar.dev" target="_blank" rel="noreferrer">Main site ↗</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <p class="kicker">Computer Science undergraduate · Class of 2029</p>
        <h1 id="hero-title">Adarsh R.<br /><em>Kumar</em></h1>
        <p class="lede">I build thoughtful things for the web and keep learning how technology can make everyday experiences better.</p>
        <div class="actions">
          <a class="button button-dark" href="https://adarshrkumar.dev" target="_blank" rel="noreferrer">Visit my main site <span>↗</span></a>
          <a class="text-link" href="#about">A little about me <span>↓</span></a>
        </div>
      </section>

      <section class="split-section" id="about" aria-labelledby="about-title">
        <p class="section-number">01 / ABOUT</p>
        <div>
          <h2 id="about-title">Curious by default.<br /><span>Always making.</span></h2>
          <p class="body-copy">I’m an undergraduate Computer Science student at Santa Clara University, interested in the intersection of technology, creativity, and people.</p>
          <p class="body-copy">This page is a small introduction. My main site is where the fuller picture lives.</p>
        </div>
      </section>

      <section class="split-section compact" id="work" aria-labelledby="work-title">
        <p class="section-number">02 / RIGHT NOW</p>
        <div>
          <h2 id="work-title">Learning, building,<br /><span>figuring it out.</span></h2>
          <div class="focus-list">
            <div><strong>Computer Science</strong><span>Coursework &amp; fundamentals</span></div>
            <div><strong>Web development</strong><span>Useful, expressive interfaces</span></div>
            <div><strong>Music, history &amp; geography</strong><span>Things I keep coming back to</span></div>
          </div>
        </div>
      </section>

      <section class="contact" aria-labelledby="contact-title">
        <p class="section-number">03 / ELSEWHERE</p>
        <div>
          <h2 id="contact-title">Find me<br /><em>online.</em></h2>
          <div class="link-row">
            {links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span>↗</span></a>)}
          </div>
        </div>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} Adarsh R. Kumar</span><span>ARK / SCU / 2029</span></footer>
  </body>
</html>
