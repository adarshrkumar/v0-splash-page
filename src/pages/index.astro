        <a href="https://github.com/adarshrkumar" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/adarshrkumar/" target="_blank" rel="noreferrer">LinkedIn</a>
      </footer>
    </main>
  </body>
</html>
